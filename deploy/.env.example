# ── 网络配置 ─────────────────────────────────────────────────
# macvlan 父网卡:必须是有线物理网卡。
# 推荐 USB 网卡(如 eth1):跨物理端口方案,让宿主机也能访问容器
# (见 docs/mihomo-gateway-network.md 的原理说明)
PARENT_IFACE=eth1

# macvlan 网络名(一般无需改,除非与既有网络冲突)
NETWORK_NAME=macnet

# 局域网网段与网关(需与主路由一致)
SUBNET=192.168.3.0/24
GATEWAY=192.168.3.1

# ── 容器配置 ─────────────────────────────────────────────────
# mihomo 容器在局域网中的固定 IP(旁路由网关/DNS 指向它)
MIHOMO_IP=192.168.3.100

# 容器名
CONTAINER_NAME=yacd-mihomo

# 镜像名:tag
IMAGE_NAME=yacd-mihomo:latest

# Express 监听端口(容器内)
PORT=80

# mihomo RESTful API 地址(容器内,通常无需改)
MIHOMO_TARGET=http://127.0.0.1:9090
